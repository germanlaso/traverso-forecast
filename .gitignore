*.swo

# ── Test fixtures (outputs pesados de /plan) ──────────────────────
# Las métricas extraídas (.txt) y el script (.py) SÍ se commitean.
# Solo ignoramos los JSON crudos del endpoint, que son grandes.
tests/fixtures/*.json
body_*.json

# ── Backups locales de BD ─────────────────────────────────────────
# Dumps de pg_dump generados antes de migraciones grandes.
# Patrón específico para no afectar migrate_*.sql que SÍ se versionan.
backup_*.sql

# ── Diagnóstico de forecast (evidencia ordenada en evidencia/) ────
# Backups de código y CSV crudos de eval_forecast_error.py.
# Los CSV de evidencia versionada viven en evidencia/, no se ignoran.
*.bak
forecast/eval_error_*.csv

# artefactos de tuning (jun 2026)
*.bak-*
forecast/*.log
forecast/eval_*.csv

